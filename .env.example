# Supabase (Lovable Cloud)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Site URL (canonical production domain, required for payment callbacks and email links)
# Production: https://cashgpt.in
# Local dev: http://localhost:3000
SITE_URL=https://cashgpt.in
VITE_SITE_URL=https://cashgpt.in

# AI assistant
GEMINI_API_KEY=

# Offerwalls
TIMEWALL_SECRET_KEY=
OFFER_FEED_CRON_SECRET=

# Advertiser marketplace — Razorpay (Phase 2)
# Dashboard → Settings → API Keys. Use rzp_test_* keys until launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → URL https://<host>/api/public/razorpay-webhook
# Events: payment.captured, order.paid, payment.failed, refund.created,
#         refund.processed, payment.dispute.lost
RAZORPAY_WEBHOOK_SECRET=