{
  "version": 3,
  "framework": {
    "name": "nitro",
    "version": "3.0.260603-beta"
  },
  "overrides": {},
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/assets/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=2592000, stale-while-revalidate=86400"
      },
      "src": "/icons/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=2592000, stale-while-revalidate=86400"
      },
      "src": "/assistant-mascot.webp"
    },
    {
      "headers": {
        "cache-control": "public, max-age=2592000, stale-while-revalidate=86400"
      },
      "src": "/icon-128.webp"
    },
    {
      "headers": {
        "cache-control": "public, max-age=2592000, stale-while-revalidate=86400"
      },
      "src": "/logo-horizontal-light.webp"
    },
    {
      "headers": {
        "cache-control": "public, max-age=2592000, stale-while-revalidate=86400"
      },
      "src": "/logo-horizontal-dark.webp"
    },
    {
      "headers": {
        "cache-control": "public, max-age=2592000, stale-while-revalidate=86400"
      },
      "src": "/landing/(.*)"
    },
    {
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "src": "/_serverFn/(.*)"
    },
    {
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "src": "/api/(.*)"
    },
    {
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "src": "/auth/(.*)"
    },
    {
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "src": "/manifest.json"
    },
    {
      "headers": {
        "cache-control": "public, max-age=2592000, stale-while-revalidate=86400"
      },
      "src": "/(.*)/*.webp"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/(.*)/*.woff2"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/(.*)/*.woff"
    },
    {
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "src": "/(.*)/*.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/__server"
    }
  ]
}